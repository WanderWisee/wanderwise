{
  "expo": {
    "name": "WanderWise",
    "slug": "wanderwise",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wanderwise",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "WanderWise uses your photos for your profile picture and journal posts."
      },
      "bundleIdentifier": "com.wanderwise.app"
    },
    "android": {
      "package": "com.wanderwise.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4EA",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WanderWise uses your location to check in at your trip meeting point."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "WanderWise uses your camera for Tour Day check-in photos.",
          "photosPermission": "WanderWise uses your photos for your profile and travel stories.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
