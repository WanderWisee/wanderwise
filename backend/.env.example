# Copy this file to .env and fill in your real values.
# .env should NEVER be committed to GitHub (already covered by .gitignore).

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=wanderwise

# Any random long string works. Used to sign login tokens.
JWT_SECRET=change_this_to_a_long_random_string

PORT=3001
