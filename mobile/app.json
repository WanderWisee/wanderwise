{
  "expo": {
    "name": "WanderWise",
    "slug": "wanderwise",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wanderwise",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "WanderWise uses your photos for your profile picture and journal posts."
      },
      "bundleIdentifier": "com.wanderwise.app"
    },
    "android": {
      "package": "com.wanderwise.app",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-logo.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4EA",
          "dark": {
            "image": "./assets/brand/splash-logo.png",
            "backgroundColor": "#F7F4EA"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WanderWise uses your location to check in at your trip meeting point."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "WanderWise uses your camera for Tour Day check-in photos.",
          "photosPermission": "WanderWise uses your photos for your profile and travel stories.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#331C08",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "66c18032-29a9-4070-9685-79fca44482d2"
      }
    },
    "owner": "geilonns-team",
    "updates": {
      "url": "https://u.expo.dev/66c18032-29a9-4070-9685-79fca44482d2"
    }
  }
}
