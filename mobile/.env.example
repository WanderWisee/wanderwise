# Kopyahin bilang ".env.local" (naka-gitignore, kaya hindi masasama sa commit) at palitan ang IP ng laptop na nagpapatakbo ng backend.
# Kapag hindi itinakda, kusang gagamitin ang IP ng laptop na nagpapatakbo ng `npx expo start`.
# Pagkatapos baguhin, i-restart gamit ang: npx expo start -c
EXPO_PUBLIC_API_URL=http://192.168.1.151:5269/api

# Address ng web app — para pareho ang invite link ng web at mobile.
EXPO_PUBLIC_WEB_URL=http://192.168.1.151:3000
